{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "publish-packages": "turbo run build lint --filter=./packages/* && changeset version && changeset publish && pnpm i",
    "lint": "turbo run build lint",
    "build": "turbo run build",
    "dev": "turbo run watch --parallel",
    "build:wasmer": "VITE_USE_PULSE_VM=true pnpm --filter test-app-vue build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.25.0",
    "turbo": "^2.5.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.30.0"
}
